# docker compose 的可選覆寫。整份都有預設值，不建 .env 也跑得起來。
#
#   cp .env.example .env
#
# 只有 CLI_PROXY_API_KEY 這一項需要與另一個檔案同步：docker/cliproxy/config.yaml 的
# api-keys。兩邊不一致 gateway 會回 401。

# gateway 的 api-key。改了就要同步改 docker/cliproxy/config.yaml。
CLI_PROXY_API_KEY=slide-maker-local

# 對外 port（都只綁 127.0.0.1）。
SLIDE_MAKER_PORT=4173
CLI_PROXY_PORT=8317

# 模型。可用的 slug 以 gateway 實際回報為準：
#   curl -H "Authorization: Bearer slide-maker-local" http://localhost:8317/v1/models
SLIDE_MAKER_IMAGE_MODEL=gpt-image-2
SLIDE_MAKER_TEXT_MODEL=gpt-5.6-terra
SLIDE_MAKER_SEARCH_MODEL=gpt-5.6-terra

# 單次模型呼叫上限（毫秒，5000–1800000）。
SLIDE_MAKER_OPENAI_TIMEOUT_MS=300000

# 「貼上網址」補抓動態網頁的第三方 render 服務：jina 或 none。
# jina＝把該網址與其內容送到 Jina AI；不想外送就設 none。
SLIDE_MAKER_WEB_RENDER_ENGINE=jina

# PaddleOCR 層級：tiny / small / medium。
SLIDE_MAKER_OCR_MODEL_TIER=medium

# 只有要從 localhost 以外的網址開編輯器時才填（逗號分隔，不接受萬用字元）。
# SLIDE_MAKER_TRUSTED_HOSTS=my-desktop.local

# 映像覆寫（想 pin 版本或用自己 build 的時候）。
# CLI_PROXY_IMAGE=eceasy/cli-proxy-api:latest
# SLIDE_MAKER_IMAGE=slide-maker:local
