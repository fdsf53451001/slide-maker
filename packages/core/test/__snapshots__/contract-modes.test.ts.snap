    "height": 1080
  },
  "slide": {
    "purpose": "解釋代理式 AI",
    "content": {
      "blocks": [
        {
          "type": "paragraph",
          "text": "標題、三項證據與結論"
        }
      ]
    },
    "narrative": "由問題走向解法",
    "layoutHint": "左文右圖",
    "dataBasis": [
      "採用率 80%"
    ],
    "imagePrompt": "明亮企業攝影"
  },
  "style": {
    "name": "清爽風",
    "description": "大量白色留白",
    "density": "high",
    "imageDirection": "模組化資訊卡",
    "avoid": [
      "深色漸層"
    ],
    "promptTemplate": "以 {subject} 為主體",
    "designSystem": "## 色票\\n- #F7F5F0 — 內頁畫布底色\\n## 版型\\n- 標題 96px、12 欄格線"
  }
}
"
`;

