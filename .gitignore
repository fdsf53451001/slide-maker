node_modules/
# e2e/ui/setup.mjs 建的解析用 symlink（指向 apps/editor/node_modules），每次重建，不入版控
e2e/ui/node_modules
dist/
dist-types/
dist-lib/
.data/
.slide-maker-data/
.e2e-data/
# 尾斜線只匹配目錄。worktree 裡的 .venv-ocr 是指回主 checkout 的 symlink（見
# merge-needs-user-testing-first），帶斜線就忽略不到它，`git add -A` 會把一條絕對路徑
# symlink 加進版控。
.venv-ocr
# scripts/ 底下的 Python（local_inpaint.py、OCR 橋接）被 server 以子行程呼叫，執行後
# 直譯器會就地留下 bytecode 快取，內容依 Python 版本而異，不入版控。
__pycache__/
artifacts/
docs/pentest/
coverage/
playwright-report/
.playwright-mcp/
test-results/
*.tsbuildinfo

# Terraform. App state (infra/) now lives in a GCS backend; bootstrap state stays
# local. Commit .terraform.lock.hcl and the committed infra/prod.tfvars.
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/*.tfplan
infra/terraform.tfvars
infra/bootstrap/.terraform/
infra/bootstrap/*.tfstate
infra/bootstrap/*.tfstate.*
infra/bootstrap/*.tfplan
infra/bootstrap/terraform.tfvars

# docker compose 的本機檔案。config.yaml 有 gateway 的 api-key、auths/ 是 Codex 的
# OAuth 憑證（等同登入態）；範本是 docker/cliproxy/config.example.yaml 與 .env.example。
.env
docker/cliproxy/config.yaml
docker/cliproxy/auths/
docker/cliproxy/logs/

# cli-switch managed entries (per-CLI private fixtures)
.claude/
.cli-switch/
.kiro/
.serena/
